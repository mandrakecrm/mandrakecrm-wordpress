msgid "Close"
msgstr "Fechar"

#: includes/class-mandrakecrm-admin.php:509
msgid "Warning: Disconnecting will hurt your sales"
msgstr "Aviso: Desconectar prejudicará suas vendas"

#: includes/class-mandrakecrm-admin.php:515
msgid "You'll lose automated emails that drive repeat purchases"
msgstr "O utilizador perderá e-mails automatizados que impulsionam compras recorrentes"

#: includes/class-mandrakecrm-admin.php:519
msgid "You'll stop capturing new leads and potential customers"
msgstr "O utilizador deixará de capturar novos leads e clientes em potencial"

#: includes/class-mandrakecrm-admin.php:523
msgid "You'll lose visibility into what's actually working to drive sales"
msgstr "O utilizador perderá visibilidade do que realmente está funcionando para impulsionar vendas"

#: includes/class-mandrakecrm-admin.php:528
msgid ""
"Without MandrakeCRM, you could be leaving money on the table every single "
"day."
msgstr ""
"Sem o MandrakeCRM, o utilizador pode estar a perder dinheiro todos os dias."

